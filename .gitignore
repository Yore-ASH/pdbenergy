# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Data
#
# data/raw        raw PDB entries, re-downloadable with:
#                   python -m pdbenergy.cli download
# data/processed  the featurised-graph cache (~350 MB for 14 proteins). Pure
#                 cache: rebuilt automatically in ~90 s on the next training run.
#
# data/interim IS committed on purpose: it holds the physics-labelled
# conformer ensembles (a few MB) that take ~30 minutes of OpenMM work to
# produce. Committing them lets anyone retrain immediately.
# ---------------------------------------------------------------------------
data/raw/
data/processed/

# Scratch directories the physics tests and the ensemble debug path write into.
# data/interim itself IS tracked (see above), so these need explicit rules.
data/interim/_tests/
data/interim/_dbg/
data/interim/*_clean.pdb
data/interim/*_nmr*.pdb

# Inventory report: derived from data/raw, which is itself not committed, so this
# would be a multi-MB description of files the repository does not contain.
# Regenerate with:  python -m pdbenergy.cli inventory --no-table
outputs/inventory.json

# Iterative training: per-round run directories accumulate (~0.7 MB each) and are
# regenerable, so they are ignored. The *evidence* is kept: rounds.jsonl /
# rounds.md (the round-by-round metrics), split.json (the frozen split) and the
# best/ checkpoint selected on validation MAE.
outputs/iterative/round_*/

# ---------------------------------------------------------------------------
# Run logs (per-stage stdout from scripts/run_pipeline.ps1)
# ---------------------------------------------------------------------------
logs/

# ---------------------------------------------------------------------------
# Trained weights are ~170 KB each and ARE committed so the shipped model can be
# used without retraining. Uncomment to keep the repository code-only.
# ---------------------------------------------------------------------------
# outputs/**/checkpoint.pt

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Rendered copies of the docs (generated by the reader, not by this repo).
TeachFlow.html

